# terraform/environments/prod/terraform.tfvars.example
# 실제 사용 시 terraform.tfvars로 복사하여 값을 채워주세요.
# terraform.tfvars 파일은 .gitignore에 추가하는 것을 권장합니다.

# ============================================================================
# 기본 설정
# ============================================================================

aws_region   = "ap-northeast-2"
aws_profile  = "shakishaki"  # AWS CLI 프로파일 이름
environment  = "prod"
project_name = "shakishaki"

# ============================================================================
# 기존 리소스 참조 (실제 값으로 변경 필요)
# ============================================================================

# VPC 설정 (둘 중 하나 선택)
# 방법 1: VPC ID 직접 지정 (권장 - Name 태그 없어도 됨)
vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

# 방법 2: VPC Name 태그로 조회 (위 vpc_id를 빈 문자열 ""로 설정 시 사용)
# vpc_id   = ""
# vpc_name = "shakishaki-vpc"

# Private Subnet 설정 (둘 중 하나 선택)
# 방법 1: Subnet ID 직접 지정 (권장 - 가장 안정적)
private_subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-yyyyyyyyyyyyyyyyy"
]

# 방법 2: 태그 기반 조회 (위 private_subnet_ids를 빈 배열 []로 설정 시 사용)
# private_subnet_ids = []
# private_subnet_tags = {
#   Type = "private"
# }

# ECS 클러스터 이름
ecs_cluster_name = "shakishaki-cluster"

# ECS 태스크 Security Group 이름
ecs_security_group_name = "shakishaki-ecs-tasks-sg"

# ============================================================================
# ECS 설정
# ============================================================================

# ECS 컨테이너가 수신하는 포트
ecs_container_port = 8080

# ============================================================================
# Service Discovery 설정
# ============================================================================

# Cloud Map 프라이빗 DNS 네임스페이스
service_discovery_namespace = "shakishaki.local"

# ============================================================================
# API Gateway 설정
# ============================================================================

# CORS 허용 Origin (프론트엔드 도메인)
cors_allowed_origins = [
  "https://shakishaki.com",
  "https://www.shakishaki.com"
]

# CloudWatch 로그 보존 기간 (일)
log_retention_days = 30
