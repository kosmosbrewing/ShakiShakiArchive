# Public build-time values only. Every VITE_* value is embedded in the browser bundle.
# Never put server secrets, OAuth client secrets, payment secrets, or admin secrets here.

# Development defaults to http://localhost:8080 when this is empty or absent.
VITE_API_URL=http://localhost:8080

# Optional analytics/share integrations.
VITE_GA_ID=
VITE_KAKAO_APP_KEY=

# Compatibility helpers in src/services/socialAuth.ts.
# The active login/signup UI uses backend-owned Naver/Kakao OAuth URLs instead.
# Google has no verified backend route or active UI and must remain disabled until integrated.
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=
VITE_NAVER_CLIENT_ID=
VITE_NAVER_REDIRECT_URI=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=
