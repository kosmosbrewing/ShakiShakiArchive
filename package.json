{
  "name": "shakishaki-archive-frontend",
  "description": "ShakiShaki Archive - 의류 쇼핑몰 프론트엔드 (Vue 3 + TypeScript + Tailwind CSS).",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "author": {
    "name": "ShakiShaki",
    "url": "https://github.com/kosmosbrewing"
  },
  "keywords": [
    "vue",
    "typescript",
    "shadcn",
    "shadcn/vue",
    "tailwind",
    "landing-page",
    "template",
    "responsive-design"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "docs:lint": "node scripts/verify-docs.js",
    "build": "vue-tsc && vite build && mkdir -p dist/fonts && cp public/fonts/*.woff2 dist/fonts/",
    "preview": "vite preview",
    "prerender": "node scripts/prerender/index.js",
    "build:full": "npm run build && npm run prerender",
    "build:maintenance": "node scripts/build-maintenance.mjs",
    "optimize-images": "node scripts/optimize-images.js",
    "verify": "npm run docs:lint && npm run build"
  },
  "dependencies": {
    "@selemondev/vue3-marquee": "^0.0.8",
    "@vee-validate/zod": "^4.13.2",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.3.0",
    "embla-carousel-vue": "^8.3.0",
    "lucide-vue-next": "^0.452.0",
    "pinia": "^3.0.4",
    "radix-vue": "^1.9.7",
    "tailwind-merge": "^2.5.3",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.184.0",
    "vee-validate": "^4.13.2",
    "vue": "^3.5.12",
    "vue-router": "^4.6.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "autoprefixer": "^10.4.19",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^6.4.2",
    "vue-tsc": "^2.0.21"
  }
}
